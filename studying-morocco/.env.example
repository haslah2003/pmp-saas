# ── Required ────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Vercel Postgres, RDS, local…)
# Supabase: use the "Session pooler" URI from Project Settings → Database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/studying_morocco

# Long random string used to sign admin sessions and hash analytics visitors.
# Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Public URL of the site (no trailing slash). Used for SEO, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: media storage on Vercel Blob (required on Vercel) ───────────
# Without it, uploads are stored on the local disk in ./media (fine for local dev
# and for servers with a persistent disk, NOT for Vercel serverless).
BLOB_READ_WRITE_TOKEN=

# ── Optional: outgoing email (application + inquiry notifications) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_FROM_NAME=Studying in Morocco
